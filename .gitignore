node_modules/
# The toolchain packages' build output is not committed. (Scoped to packages/* so it does NOT
# catch the embedded marketplace's `agent-plugins/dist/` bundles, which ARE committed and
# freshness-checked — see aipm.workspace.ts / the dogfood.)
packages/*/dist/
coverage/
packages/*/temp/
*.tsbuildinfo
*.log
.DS_Store
*.local.*
.env
.env.*
!.env.example
.turbo/
scratch/

# Nx local cache and workspace data (local-only; not committed)
.nx/
.nx/cache/
.nx/workspace-data/

# Claude Code local configuration (auto-added)
.claude/*.local.*

# CI-only checkout of ai-plugin-marketplace/template at the pinned revision (see
# .github/template-repo.rev, .github/workflows/ci.yml) — never committed, and a local
# reproduction of the CI layout (checking the template out at this path) must not get swept in.
/.template-repo/
