{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["husky", "lint-staged"],
  "ignoreDependencies": ["husky", "lint-staged"],
  "ignore": ["agent-plugins/**", "aipm.repo.ts", "aipm.workspace.ts"],
  "workspaces": {
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
