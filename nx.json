{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/src/test-support/**/*",
      "!{projectRoot}/api-report/**/*",
      "!{projectRoot}/docs/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/.prettierrc.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/api-report", "{projectRoot}/temp"],
      "cache": true
    },
    "check:typecheck": {
      "dependsOn": ["^check:typecheck"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "check:lint-ts": {
      "dependsOn": ["^check:typecheck"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.eslint.json"
      ],
      "cache": true
    },
    "check:api-report": {
      "dependsOn": ["check:typecheck"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      // Include the pinned template revision and the AIPM_TEMPLATE_REPO/AIPM_REQUIRE_TEMPLATE
      // env vars so (a) bumping the pin (packages/core's gemini/kiro bundle parity suites — see
      // CONTRIBUTING.md "Bumping the pinned template revision") and (b) CI's checkout-then-set-env
      // step both invalidate the Nx cache, instead of silently reusing a stale pass/skip/fail from
      // before the pin bump or from a run without the template checked out.
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts",
        "{workspaceRoot}/.github/template-repo.rev",
        { "env": "AIPM_TEMPLATE_REPO" },
        { "env": "AIPM_REQUIRE_TEMPLATE" }
      ],
      "cache": true
    },
    "check": {
      "cache": true
    }
  }
}
