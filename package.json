{
  "name": "ai-plugin-marketplace-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Toolkit monorepo for authoring AI coding-assistant plugins (Claude Code, Cursor, Gemini CLI, Kiro, Vercel Skills CLI).",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "nx run-many -t build",
    "clean": "tsc --build --clean && rimraf --glob 'packages/*/dist' 'packages/*/temp' 'packages/*/*.tsbuildinfo'",
    "check": "concurrently --success all --names \"packages,workspace\" --prefix \"[{name}]\" \"pnpm run check:packages\" \"pnpm run check:workspace\"",
    "check:packages": "nx run-many --target=check --exclude=ai-plugin-marketplace-tools",
    "check:workspace": "concurrently --success all --names \"knip,deps,format\" --prefix \"[{name}]\" \"pnpm run check:knip\" \"pnpm run check:deps\" \"pnpm run check:format\"",
    "check:knip": "knip",
    "check:deps": "syncpack lint",
    "check:format": "prettier --check .",
    "test": "nx run-many --target=test --exclude=ai-plugin-marketplace-tools",
    "fix:format": "prettier --write .",
    "fix:deps": "syncpack fix-mismatches && syncpack format",
    "fix:lint-ts": "nx run-many --target=fix:lint-ts --exclude=ai-plugin-marketplace-tools",
    "docs": "pnpm -r --if-present run docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@api-extractor-tools/eslint-plugin": "^0.1.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.18.0",
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "knip": "^6.15.0",
    "nx": "^22.7.5",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "syncpack": "^15.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
