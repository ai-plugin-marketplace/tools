{
  "name": "ai-plugin-marketplace-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Toolkit monorepo for authoring AI coding-assistant plugins (Claude Code, Cursor, Gemini CLI, Kiro, Vercel Skills CLI).",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc --build && pnpm run api",
    "clean": "tsc --build --clean && rimraf 'packages/*/dist' 'packages/*/temp' 'packages/*/*.tsbuildinfo'",
    "typecheck": "tsc --build",
    "lint": "eslint packages/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "syncpack:fix": "syncpack fix-mismatches && syncpack format",
    "api": "pnpm -r --if-present run build:api",
    "api:check": "pnpm -r --if-present run check:api",
    "docs": "pnpm -r --if-present run docs",
    "check": "pnpm run typecheck && pnpm run syncpack && pnpm run lint && pnpm run knip && pnpm run format:check && pnpm run api:check && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@api-extractor-tools/eslint-plugin": "^0.1.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.18.0",
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^22.10.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "knip": "^6.15.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "syncpack": "^15.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
