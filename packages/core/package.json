{
  "name": "@ai-plugin-marketplace/core",
  "version": "0.1.0-alpha.0",
  "description": "Core build pipeline, validation, and scaffolding for the AI plugin marketplace toolkit.",
  "type": "module",
  "author": "Mike North <michael.l.north@gmail.com>",
  "main": "./dist/index.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && api-extractor run --local",
    "typecheck": "tsc --build",
    "build:api": "api-extractor run --local",
    "check:api": "api-extractor run",
    "docs": "api-documenter markdown -i temp -o docs",
    "clean": "rimraf dist *.tsbuildinfo temp"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-plugin-marketplace/tools.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
