{
  "name": "@ai-plugin-marketplace/core",
  "version": "0.9.0",
  "description": "Core build pipeline, validation, and scaffolding for the AI plugin marketplace toolkit.",
  "type": "module",
  "author": "Mike North <michael.l.north@gmail.com>",
  "main": "./dist/index.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && api-extractor run --local",
    "check": "nx run-many --targets=check:typecheck,check:lint-ts,check:api-report,test --projects=@ai-plugin-marketplace/core",
    "check:typecheck": "tsc --build",
    "check:lint-ts": "eslint src",
    "check:api-report": "api-extractor run",
    "fix:api-report": "api-extractor run --local",
    "fix:lint-ts": "eslint src --fix",
    "test": "vitest run",
    "docs": "api-documenter markdown -i temp -o docs",
    "clean": "rimraf dist *.tsbuildinfo temp"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.2.0",
    "semver": "^7.7.4",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-plugin-marketplace/tools.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
